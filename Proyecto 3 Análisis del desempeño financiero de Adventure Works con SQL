-- Conteo de Cantidades no válidas en ventas_2017 como filas_cantidad_no_valida
-- Ajusta la condición según tu regla de negocio: <= 0 (no se permite cero)
select
count (*) as filas_cantidad_no_valida
from ventas_2017
where cantidad_pedido <=0

