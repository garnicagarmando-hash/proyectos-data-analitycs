-- Utiliza `::integer` para convertir el ingreso_total y costo_total a numero entero para obterner totales legibles.

-- Ordena por ingresos de manera descendiente.
select
pais,
clave_territorio,
sum (ingreso_total)::integer as ingresos,
sum (costo_total)::integer as costos
from ventas_clean
group by
pais,
clave_territorio
order by ingresos desc

